<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 420" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="bgGrad_Karna" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2C1B06"/>
      <stop offset="50%" stop-color="#4A2F0A"/>
      <stop offset="100%" stop-color="#0A0806"/>
    </linearGradient>

    <!-- Metallic Gold Foil Gradient -->
    <linearGradient id="goldFoil_Karna" x1="0%" y1="0%" x2="100%" y2="80%">
      <stop offset="0%" stop-color="#FFF2D6"/>
      <stop offset="35%" stop-color="#F2CC79"/>
      <stop offset="70%" stop-color="#C29541"/>
      <stop offset="100%" stop-color="#8B6724"/>
    </linearGradient>

    <!-- Radial Core Glow -->
    <radialGradient id="coreGlow_Karna" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#F2CC79" stop-opacity="0.28"/>
      <stop offset="60%" stop-color="#F5B041" stop-opacity="0.12"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Outer Rounded Container -->
  <rect width="400" height="420" rx="20" fill="url(#bgGrad_Karna)"/>

  <!-- Hairline Gold Luxury Border -->
  <rect x="10" y="10" width="380" height="400" rx="16" fill="none" stroke="url(#goldFoil_Karna)" stroke-width="1.2" opacity="0.85"/>

  <!-- Radial Aura Glow behind emblem -->
  <circle cx="200" cy="150" r="120" fill="url(#coreGlow_Karna)"/>

  <!-- Corner Filigree Ornaments -->
  <path d="M 22 36 L 36 22 M 22 22 L 36 36" stroke="#F2CC79" stroke-width="1" opacity="0.6"/>
  <path d="M 378 36 L 364 22 M 378 22 L 364 36" stroke="#F2CC79" stroke-width="1" opacity="0.6"/>
  <path d="M 22 384 L 36 398 M 22 398 L 36 384" stroke="#F2CC79" stroke-width="1" opacity="0.6"/>
  <path d="M 378 384 L 364 398 M 378 398 L 364 384" stroke="#F2CC79" stroke-width="1" opacity="0.6"/>

  <!-- Top Brand Seal -->
  <text x="200" y="44" text-anchor="middle" font-family="'Cinzel', serif" font-size="11" font-weight="700" fill="url(#goldFoil_Karna)" letter-spacing="3.5">CONSCIOUS FORM COMPANY</text>
  <line x1="80" y1="52" x2="320" y2="52" stroke="url(#goldFoil_Karna)" stroke-width="0.8" opacity="0.4"/>

  <!-- Central Archetype Icon & Crest -->
  
            <!-- Solar Disk & Radiance -->
            <circle cx="200" cy="150" r="38" fill="url(#coreGlow_Karna)" stroke="#F2CC79" stroke-width="2.5"/>
            <!-- 8 Radiant Rays -->
            <line x1="200" y1="95" x2="200" y2="108" stroke="#F2CC79" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="200" y1="192" x2="200" y2="205" stroke="#F2CC79" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="145" y1="150" x2="158" y2="150" stroke="#F2CC79" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="242" y1="150" x2="255" y2="150" stroke="#F2CC79" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="161" y1="111" x2="170" y2="120" stroke="#F2CC79" stroke-width="2" stroke-linecap="round"/>
            <line x1="239" y1="189" x2="230" y2="180" stroke="#F2CC79" stroke-width="2" stroke-linecap="round"/>
            <line x1="161" y1="189" x2="170" y2="180" stroke="#F2CC79" stroke-width="2" stroke-linecap="round"/>
            <line x1="239" y1="111" x2="230" y2="120" stroke="#F2CC79" stroke-width="2" stroke-linecap="round"/>
        

  <!-- Character & Quality Banner -->
  <rect x="110" y="215" width="180" height="22" rx="11" fill="rgba(10, 8, 6, 0.7)" stroke="url(#goldFoil_Karna)" stroke-width="1"/>
  <text x="200" y="230" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="700" fill="#F2CC79" letter-spacing="2">KARNA • RESOLVE</text>

  <!-- Kit Title Display -->
  <text x="200" y="262" text-anchor="middle" font-family="'Playfair Display', serif" font-size="16" font-weight="700" font-style="italic" fill="#FFFFFF">The Sol Invictus Kit</text>

  <!-- Included Items Specification -->
  
        <g transform="translate(36, 280)">
            <rect width="328" height="21" rx="4" fill="rgba(10, 8, 6, 0.65)" stroke="rgba(229, 186, 99, 0.25)" stroke-width="0.8"/>
            <circle cx="12" cy="10.5" r="3" fill="#F2CC79"/>
            <text x="24" y="14.5" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#EDE4D8">1000D Cordura Athlete Duffel 42L</text>
        </g>
        
        <g transform="translate(36, 306)">
            <rect width="328" height="21" rx="4" fill="rgba(10, 8, 6, 0.65)" stroke="rgba(229, 186, 99, 0.25)" stroke-width="0.8"/>
            <circle cx="12" cy="10.5" r="3" fill="#F2CC79"/>
            <text x="24" y="14.5" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#EDE4D8">Reinforced Dip & Pull-up Belt</text>
        </g>
        
        <g transform="translate(36, 332)">
            <rect width="328" height="21" rx="4" fill="rgba(10, 8, 6, 0.65)" stroke="rgba(229, 186, 99, 0.25)" stroke-width="0.8"/>
            <circle cx="12" cy="10.5" r="3" fill="#F2CC79"/>
            <text x="24" y="14.5" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#EDE4D8">Zero-Dust Liquid Grip Chalk</text>
        </g>
        
        <g transform="translate(36, 358)">
            <rect width="328" height="21" rx="4" fill="rgba(10, 8, 6, 0.65)" stroke="rgba(229, 186, 99, 0.25)" stroke-width="0.8"/>
            <circle cx="12" cy="10.5" r="3" fill="#F2CC79"/>
            <text x="24" y="14.5" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#EDE4D8">Deep-Tissue Percussion Ball</text>
        </g>
        

  <!-- Subtle Bottom Quality Seal -->
  <text x="200" y="398" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" font-weight="600" fill="#F2CC79" opacity="0.8" letter-spacing="1.5">CALIBRATED GYM &amp; RECOVERY KIT</text>
</svg>